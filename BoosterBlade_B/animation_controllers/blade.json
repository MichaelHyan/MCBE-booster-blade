						{"blade_release":"query.get_equipped_item_name=='blade' && !query.is_using_item && query.scoreboard('charge') >= 9"},
						{"blade_charge_a":"query.get_equipped_item_name=='blade' && query.is_using_item && query.scoreboard('charge') == 0"},
						{"blade_charge_b":"query.get_equipped_item_name=='blade' && query.is_using_item && query.scoreboard('charge') == 1"},
